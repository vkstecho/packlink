rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function signedIn() {
      return request.auth != null && request.auth.token.phone_number != null;
    }

    function phone() {
      return request.auth.token.phone_number;
    }

    // Must match js/config.js SUPER_ADMIN
    function isSuperAdmin() {
      return signedIn() && phone() == '+918929397949';
    }

    function memberDoc(uid) {
      return get(/databases/$(database)/documents/members/$(uid)).data;
    }

    function memberExists(uid) {
      return exists(/databases/$(database)/documents/members/$(uid));
    }

    // Active member of the network (or super admin)
    function isActiveMember() {
      return signedIn() && (
        isSuperAdmin() ||
        (memberExists(phone()) && memberDoc(phone()).active != false)
      );
    }

    function isAdmin() {
      return signedIn() && (
        isSuperAdmin() ||
        (memberExists(phone()) && memberDoc(phone()).role == 'admin' && memberDoc(phone()).active != false)
      );
    }

    function isOwner(uid) {
      return signedIn() && phone() == uid;
    }

    // Fields a normal member may change on their own profile
    function onlySelfProfileKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'about', 'company', 'designation', 'department', 'photoURL', 'lastActive', 'lastReadAt',
                  'startYear', 'experienceYears', 'dob', 'targetDesignation', 'targetCtc', 'openToMobility']);
    }

    function chatOnlyAdminsCanSend() {
      return exists(/databases/$(database)/documents/settings/chat)
        && get(/databases/$(database)/documents/settings/chat).data.onlyAdminsCanSend == true;
    }

    function onlyPresenceKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['lastActive', 'lastReadAt']);
    }

    // ---- members (public directory; doc id = E.164 phone) ----
    match /members/{uid} {
      // All active members can list/read the directory
      allow read: if isActiveMember();

      // Super admin bootstrap: create own admin doc if missing
      allow create: if isSuperAdmin() && isOwner(uid)
        || isAdmin();

      // Own profile / presence updates
      allow update: if isActiveMember() && isOwner(uid) && onlySelfProfileKeys()
        // Admins may edit any member (role, active, profile fields)
        || isAdmin();

      // Soft-remove is done by delete or active:false; only admin (not self-demote super)
      // Owner may delete own account (self-service delete)
      allow delete: if (isAdmin() && uid != '+918929397949') || (isOwner(uid) && uid != '+918929397949');
    }

    // ---- private HR fields (admin write; owner can read + update own ctc) ----
    match /memberPrivate/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      // Admins full write
      allow create: if isAdmin() || (isOwner(uid) && request.resource.data.keys().hasOnly(['ctc']));
      allow update: if isAdmin()
        || (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ctc']));
      allow delete: if isAdmin() || isOwner(uid);
    }

    // ---- group chat messages ----
    match /messages/{msgId} {
      allow read: if isActiveMember();

      allow create: if isActiveMember()
        && request.resource.data.senderPhone == phone()
        && request.resource.data.keys().hasAll(['senderPhone', 'createdAt', 'deleted'])
        && request.resource.data.deleted == false
        && (!chatOnlyAdminsCanSend() || isAdmin());

      // Soft-delete: author or admin may clear content
      // Reactions: any active member may update the reactions map only
      allow update: if isActiveMember() && (
        // soft delete by author or admin
        (
          (resource.data.senderPhone == phone() || isAdmin())
          && request.resource.data.deleted == true
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['deleted', 'text', 'imageURL', 'reactions'])
        )
        ||
        // reactions only
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.senderPhone == resource.data.senderPhone
          && request.resource.data.createdAt == resource.data.createdAt
        )
      );

      allow delete: if isAdmin();
    }

    // ---- job board ----
    match /jobs/{jobId} {
      allow read: if isActiveMember();

      allow create: if isActiveMember()
        && request.resource.data.postedBy == phone()
        && request.resource.data.keys().hasAll(['title', 'postedBy', 'createdAt']);

      allow update: if isActiveMember() && (
        // interest toggle — only interested array changes
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interested'])
        ||
        // poster or admin may edit job fields
        (resource.data.postedBy == phone() || isAdmin())
      );

      allow delete: if isActiveMember() && (
        resource.data.postedBy == phone() || isAdmin()
      );
    }

    // ---- access requests (unregistered users asking to join) ----
    match /accessRequests/{uid} {
      // Anyone signed-in can create/update their own pending request
      allow create, update: if signedIn() && isOwner(uid)
        && request.resource.data.mobile == phone()
        && request.resource.data.status == 'pending';

      // Admins can read all and mark approved
      allow read, update: if isAdmin();

      allow delete: if isAdmin() || isOwner(uid);
    }

    // ---- app settings (chat controls etc.) ----
    match /settings/{docId} {
      allow read: if isActiveMember();
      allow write: if isAdmin();
    }

    // ---- private DM threads (message requests + 1:1 chat) ----
    // Doc id = sorted phones with + stripped, joined by "_" e.g. 911111_922222
    match /dmThreads/{threadId} {
      // Allow get when missing (client pre-check) or when caller is a participant
      allow get: if isActiveMember() && (
        !exists(/databases/$(database)/documents/dmThreads/$(threadId))
        || resource.data.participants.hasAny([phone()])
        || isAdmin()
      );
      allow list: if isActiveMember();
      allow create: if isActiveMember()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAny([phone()])
        && request.resource.data.requestedBy == phone()
        && request.resource.data.status == 'pending';
      allow update: if isActiveMember() && resource.data.participants.hasAny([phone()]);
      allow delete: if isAdmin()
        || (isActiveMember() && resource.data.participants.hasAny([phone()]));
    }

    match /dmMessages/{msgId} {
      // Participants only (enforced on write via thread status; read filtered client-side by threadId)
      allow read: if isActiveMember();
      allow create: if isActiveMember()
        && request.resource.data.senderPhone == phone()
        && request.resource.data.keys().hasAll(['threadId', 'senderPhone', 'createdAt', 'text'])
        && exists(/databases/$(database)/documents/dmThreads/$(request.resource.data.threadId))
        && get(/databases/$(database)/documents/dmThreads/$(request.resource.data.threadId)).data.status == 'accepted'
        && get(/databases/$(database)/documents/dmThreads/$(request.resource.data.threadId)).data.participants.hasAny([phone()]);
      allow update: if isActiveMember() && resource.data.senderPhone == phone();
      allow delete: if isAdmin() || (isActiveMember() && resource.data.senderPhone == phone());
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
